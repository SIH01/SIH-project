# Copy this to ".env" (same folder) and keep .env out of version control.

PORT=5001

# Any long random string.
JWT_SECRET=replace_this_with_a_long_random_string

# Reuse your Supabase project's connection string. If the direct connection
# host (db.xxxx.supabase.co) gives you an ENOTFOUND error, use the Session
# Pooler string instead (Project > Connect > Session pooler).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# There is no fixed admin login — create or promote one with:
#   node scripts/createAdmin.js
