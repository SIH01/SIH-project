# Copy this to ".env" (same folder) and keep .env out of version control.

PORT=5001

# Any long random string.
JWT_SECRET=replace_this_with_a_long_random_string

# Reuse your Supabase project's connection string (Project Settings >
# Database > Connection string > URI tab).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# There is no fixed admin login — create one with:
#   node scripts/createAdmin.js
